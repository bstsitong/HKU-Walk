{
  "expo": {
    "name": "HKU-Walk",
    "slug": "HKU-Walk",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/hku-walk-icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://47.239.18.183/api/mobile-updates/manifest/",
      "checkAutomatically": "NEVER",
      "codeSigningCertificate": "./assets/android-update-certificate.cer",
      "codeSigningMetadata": { "keyid": "main", "alg": "rsa-v1_5-sha256" }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hkuwalk",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/hku-walk-icon-foreground.png",
        "backgroundColor": "#F7F4ED"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/hku-walk-favicon.png"
    },
    "plugins": [
      ["expo-splash-screen", {"image": "./assets/hku-walk-icon-foreground.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#F7F4ED"}],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许港大漫游从相册选择头像、资料卡背景和投稿配图。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许港大漫游在使用地图时显示你的当前位置。",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
